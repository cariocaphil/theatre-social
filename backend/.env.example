# Backend-local environment file, used when running the backend directly on
# the host (outside a container), e.g. with `uv run uvicorn app.main:app`.
#
#   cp backend/.env.example backend/.env
#
# When the backend runs inside the `backend` Compose service instead, these
# same variable names are provided by compose.yml / the root `.env` file,
# and the database host below must be the Compose service name "postgres"
# rather than "localhost".

APP_NAME=theatre-social-backend
ENVIRONMENT=development

# asyncpg connection string. If Postgres is running locally on the host
# (not in a container) via `podman compose up postgres`, "localhost" is
# correct here because the host is what is connecting.
DATABASE_URL=postgresql+asyncpg://theatre_social:theatre_social_dev_password@localhost:5432/theatre_social

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Authentication (Phase 4) ---
# Name of the HTTP-only cookie holding the opaque session token.
# SESSION_COOKIE_NAME=ts_session

# How many days a session (and its cookie) stays valid.
# SESSION_LIFETIME_DAYS=30

# Whether the session cookie requires HTTPS (`Secure`) and whether it's sent
# on cross-site requests (`SameSite=None` vs `Lax`). Not real env vars --
# both are derived from ENVIRONMENT above: relaxed (`Secure=false`,
# `SameSite=Lax`) when ENVIRONMENT=development (as it is here, for local
# HTTP where frontend/backend share the "localhost" site); strict
# (`Secure=true`, `SameSite=None`) for anything else, since production's
# frontend and backend live on different Azure hostnames and the cookie must
# still be sent on those cross-site API calls. There is no
# SESSION_SECRET_KEY: session tokens are opaque, high-entropy random values
# (see app/core/security.py), not signed/encrypted, so no server-side
# secret is needed to issue or verify them.

# --- Production (Phase 6) --------------------------------------------------
# Nothing below this line is needed for local development -- these are only
# ever set as Azure Container Apps application settings in production (see
# the README's "Production Deployment" section). Shown here, commented out,
# purely for reference/documentation.

# ENVIRONMENT=production

# Same asyncpg connection string format as above, pointed at the Azure
# Database for PostgreSQL Flexible Server instance instead of local/Compose
# Postgres.
# DATABASE_URL=postgresql+asyncpg://<db-admin-user>:<password>@<server-name>.postgres.database.azure.com:5432/theatre_social

# Controls how the database connection negotiates TLS -- see
# app/core/config.py / app/db/session.py for why this must be a dedicated
# setting rather than a `?sslmode=...` query parameter on DATABASE_URL.
# Azure Database for PostgreSQL Flexible Server requires TLS, hence "require".
# DATABASE_SSL_MODE=require

# The deployed frontend's public origin(s), comma-separated if there is ever
# more than one (e.g. an apex + www domain).
# CORS_ORIGINS=https://<frontend-app-name>.<region>.azurecontainerapps.io
