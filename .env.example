# Root environment file consumed by compose.yml (podman compose / docker compose).
#
# Copy this file to `.env` before starting the stack:
#   cp .env.example .env
#
# This file only configures the container orchestration layer (Postgres
# credentials shared between the `postgres` and `backend` services, and the
# backend-to-frontend URL used *inside* the container network). The
# frontend and backend apps also have their own `.env.example` files for
# settings that only matter to that individual app.

# --- PostgreSQL (used by the postgres service and to build DATABASE_URL) ---
POSTGRES_DB=theatre_social
POSTGRES_USER=theatre_social
POSTGRES_PASSWORD=theatre_social_dev_password

# --- Backend ---
# asyncpg connection string. Host is the Compose service name "postgres",
# NOT "localhost" -- inside the backend container, "localhost" refers to the
# backend container itself, not the postgres container.
DATABASE_URL=postgresql+asyncpg://theatre_social:theatre_social_dev_password@postgres:5432/theatre_social

# Comma-separated list of origins allowed to call the backend from a browser.
# http://localhost:3000 is the frontend as seen from the host machine's browser.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Used by the frontend's Node.js server (inside the frontend container) when
# it performs server-side fetches. "backend" is the Compose service name and
# is only resolvable on the container network, not from the host.
INTERNAL_API_URL=http://backend:8000

# Used by code that runs in the user's browser. The browser is on the host
# network and cannot resolve "backend", so it must use the published host
# port via localhost instead.
NEXT_PUBLIC_API_URL=http://localhost:8000
