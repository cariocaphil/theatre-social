# Frontend-local environment file, used when running the frontend directly
# on the host (outside a container), e.g. with `pnpm dev`.
#
#   cp frontend/.env.example frontend/.env.local

# Used only by server-side code (e.g. app/page.tsx running on the Next.js
# Node server) for its own outgoing requests. If you run both the frontend
# and backend directly on the host (no containers), "localhost" is correct
# here because the Next.js server process itself is running on the host.
# Inside Compose, this is overridden to http://backend:8000.
INTERNAL_API_URL=http://localhost:8000

# Inlined into the client-side JavaScript bundle at build time and used by
# code that runs in the user's browser. The browser always talks to the
# host machine, and can never resolve Compose service names like "backend".
NEXT_PUBLIC_API_URL=http://localhost:8000
