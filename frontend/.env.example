# Frontend-local environment file, used when running the frontend directly
# on the host (outside a container), e.g. with `pnpm dev`.
#
#   cp frontend/.env.example frontend/.env.local

# Used only by server-side code (e.g. app/page.tsx running on the Next.js
# Node server) for its own outgoing requests. If you run both the frontend
# and backend directly on the host (no containers), "localhost" is correct
# here because the Next.js server process itself is running on the host.
# Inside Compose, this is overridden to http://backend:8000.
INTERNAL_API_URL=http://localhost:8000

# Inlined into the client-side JavaScript bundle at build time and used by
# code that runs in the user's browser. The browser always talks to the
# host machine, and can never resolve Compose service names like "backend".
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production (Phase 6) --------------------------------------------------
# Nothing below this line is needed for local development. Shown here,
# commented out, purely for reference/documentation -- see the README's
# "Production Deployment" section for how these are actually set.
#
# INTERNAL_API_URL and NEXT_PUBLIC_API_URL both point at the deployed
# backend Container App's public HTTPS URL in production (there is no
# private network between the two Container Apps in this MVP setup, so
# there is no separate "internal" address to use instead -- see the README).
#
# Critically, NEXT_PUBLIC_API_URL is NOT read from this file (or any runtime
# env var) in production: it must be passed as a Docker build argument
# (`--build-arg NEXT_PUBLIC_API_URL=...`) so Next.js can inline it into the
# client bundle at build time, before the image is ever run. See
# frontend/Dockerfile.prod and .github/workflows/ci.yml (the
# `BACKEND_PUBLIC_URL` repository variable).
#
# INTERNAL_API_URL=https://<backend-app-name>.<region>.azurecontainerapps.io
# NEXT_PUBLIC_API_URL=https://<backend-app-name>.<region>.azurecontainerapps.io
