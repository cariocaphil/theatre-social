# Production image for the Next.js frontend (Azure Container Apps).
#
# Multi-stage build producing a minimal runtime image from the standalone
# server output (`output: "standalone"` in next.config.ts). Differs from the
# dev `Dockerfile` in that code is copied in (not bind-mounted) and actually
# runs, and `NEXT_PUBLIC_API_URL` must be supplied as a *build* argument:
# `NEXT_PUBLIC_*` variables are inlined into the client JS bundle by Next.js
# at build time, so setting it as a container runtime env var alone would
# have no effect on already-built pages/bundles. `INTERNAL_API_URL` is only
# read server-side at request time, so it stays a normal runtime env var
# (set as a Container Apps app setting, not a build arg).

FROM node:20-bookworm-slim AS base
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH"
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Baked into the client bundle now, at build time -- see the top-of-file note.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1
# INTERNAL_API_URL is not used during the build (no server-side data
# fetching happens at build time in this app), so a placeholder is enough to
# satisfy any code path that reads it eagerly at import time.
ENV INTERNAL_API_URL="http://localhost:8000"

RUN pnpm build

FROM base AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN groupadd --system --gid 1001 app \
    && useradd --system --uid 1001 --gid app --create-home --shell /usr/sbin/nologin app

# `.next/standalone` already contains a pruned `node_modules` plus a
# self-contained `server.js`; `.next/static` and `public` are copied
# alongside it because the standalone server doesn't bundle static assets.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=app:app /app/.next/standalone ./
COPY --from=builder --chown=app:app /app/.next/static ./.next/static

USER app

EXPOSE 3000

# server.js reads `process.env.PORT` / `HOSTNAME` itself at startup, so no
# shell expansion is needed here -- Azure can override either via an app
# setting without rebuilding the image.
CMD ["node", "server.js"]
